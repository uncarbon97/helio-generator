#set($hasCreatedAt = false)
#set($nameField = $pk.camelAttrName)
#set($nameFieldFound = false)
#foreach ($column in $columns)
#if($column.columnName == 'created_at')
#set($hasCreatedAt = true)
#end
#if(!$nameFieldFound
    && $column.attrType == 'String'
    && $column.columnName != $pk.columnName
    && $column.columnName != "tenant_id"
    && $column.columnName != "del_flag"
    && $column.columnName != "created_at"
    && $column.columnName != "created_by"
    && $column.columnName != "updated_at"
    && $column.columnName != "updated_by"
)
#set($nameField = $column.camelAttrName)
#set($nameFieldFound = true)
#end
#end
<script lang="ts" setup>
import type {
  OnActionClickParams,
  VxeTableGridOptions,
} from '#/adapter/vxe-table';
import type { ${pascalCaseClassName}Api } from '#/api';

import {useVbenDrawer} from '@vben/common-ui';

import {message} from 'antdv-next';

import {useVbenVxeGrid} from '#/adapter/vxe-table';

import {delete${pascalCaseClassName},} from '#/api';
import {confirmAction} from '#/utils/confirm';

import {useColumns, useGridFormSchema} from './data';
import Form from './modules/form.vue';

const [FormDrawer, formDrawerApi] = useVbenDrawer({
  connectedComponent: Form,
  destroyOnClose: true,
  closeOnClickModal: false,
});

const [Grid, gridApi] = useVbenVxeGrid({
  formOptions: {
    schema: useGridFormSchema(),
    submitOnChange: false,
  },
  gridOptions: {
    columns: useColumns(onActionClick),
    height: 'auto',
    keepSource: true,
    proxyConfig: {
      ajax: {
        query: async ({ page }, formValues) => {
#if($hasCreatedAt)
          const [beginAt, endAt] = formValues.createdAtRange ?? [];
#end
          return await get${pascalCaseClassName}List({
#if($hasCreatedAt)
            beginAt: beginAt?.toISOString?.(),
            endAt: endAt?.toISOString?.(),
#end
            pageParam: {
              pageNum: page.currentPage,
              pageSize: page.pageSize,
            },
#if(${useQueryFormSchema})
#foreach ($column in $columns)
#if($column.columnName != $pk.columnName
    && $column.columnName != "tenant_id"
    && $column.columnName != "del_flag"
    && $column.columnName != "created_at"
    && $column.columnName != "created_by"
    && $column.columnName != "updated_at"
    && $column.columnName != "updated_by"
)
            $column.camelAttrName: formValues.$column.camelAttrName,
#end
#end
#end
          });
        },
      },
    },
    rowConfig: {
      keyField: 'id',
    },

    toolbarConfig: {
      custom: true,
      export: false,
      // 刷新保持当前页码
      refresh: { code: 'query' },
      search: true,
      zoom: true,
    },
  } as VxeTableGridOptions<${pascalCaseClassName}Api.${pascalCaseClassName}DTO>,
});

function onActionClick(e: OnActionClickParams<${pascalCaseClassName}Api.${pascalCaseClassName}DTO>) {
  switch (e.code) {
    case 'delete': {
      onDelete(e.row);
      break;
    }
    case 'edit': {
      onEdit(e.row);
      break;
    }
  }
}

async function onEdit(row: ${pascalCaseClassName}Api.${pascalCaseClassName}DTO) {
  // 修改前拉取详情，保证数据为最新
  const detail = await get${pascalCaseClassName}Detail(row.id);
  formDrawerApi.setData(detail).open();
}

async function onDelete(row: ${pascalCaseClassName}Api.${pascalCaseClassName}DTO) {
  const confirmed = await confirmAction(
    $t('ui.actionMessage.deleteConfirm', [row.$nameField]),
  );
  if (!confirmed) return;
  const hideLoading = message.loading({
    content: $t('ui.actionMessage.deleting', [row.$nameField]),
    duration: 0,
    key: 'action_process_msg',
  });
  try {
    await delete${pascalCaseClassName}(row.id);
    message.success({
      content: $t('ui.actionMessage.deleteSuccess', [row.$nameField]),
      key: 'action_process_msg',
    });
    onRefresh();
  } catch {
    hideLoading();
  }
}

function onRefresh() {
  gridApi.query();
}

function onCreate() {
  formDrawerApi.setData(null).open();
}
</script>
<template>
  <Page auto-content-height>
    <FormDrawer @success="onRefresh" />
    <Grid>
      <template #toolbar-tools>
        <Button type="primary" @click="onCreate">
          <Plus class="size-5" />
          {{ $t('ui.actionTitle.create') }}
        </Button>
      </template>
    </Grid>
  </Page>
</template>
